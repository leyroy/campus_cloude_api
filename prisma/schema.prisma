generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  firstName       String
  lastName        String
  password        String
  confirmPassword String
  isActive        Boolean         @default(false)
  status          AccountStatus   @default(ACTIVE)
  phone           String
  isPhoneVerified Boolean         @default(false)
  isEmailVerified Boolean         @default(false)
  lastLogedIn     DateTime        @default(now())
  schoolId        String?
  addressId       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  address         Address?        @relation(fields: [addressId], references: [id])
  school          School?         @relation(fields: [schoolId], references: [id])
  userRoles       UserRole[]
  assignedRoles   UserRole[]      @relation("AssignedByRelation")
  rolesCreated    Role[]          @relation("UserCreatedRoles")
  Document        Document[]
  SchoolProfile   SchoolProfile[]

  Session Session[]
}

model School {
  id        String        @id @default(cuid())
  name      String
  isActive  Boolean       @default(false)
  status    AccountStatus @default(ACTIVE)
  addressId String?
  address   Address?      @relation(fields: [addressId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users         User[]
  OwnersSchool  OwnersSchool[]
  Plan          Plan[]
  Document      Document[]
  SchoolProfile SchoolProfile[]
}

model VerificationToken {
  id         String           @id @default(cuid())
  identifier String
  token      String           @unique
  expires    DateTime
  type       VerificationType
  createdAt DateTime @default(now())

  @@index([identifier])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String
  ipAddress    String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Relations
  user         User     @relation(fields: [userId], references: [id])

  @@index([sessionToken])
}

model SchoolProfile {
  id            String    @id @default(cuid())
  schoolId      String    @unique
  school        School    @relation(fields: [schoolId], references: [id])
  slogan        String
  about         String
  description   String
  contactEmail  String
  contactPhone  String
  establishedAt DateTime?
  motto         String
  colors        String? // e.g. "#ff0000,#ffffff"
  website       String?
  facebook      String?
  twitter       String?
  linkedin      String?
  instagram     String?
  youtube       String?
  principalName String
  principalBio  String
  founderName   String
  founderBio    String?
  licenseNumber String?
  adminNote     String?
  updatedById   String
  updatedBy     User[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Plan {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  description  String?
  price        Float
  currency     String   @default("USD")
  billingCycle String   @default("MONTHLY")
  features     Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  schools      School[]
}

model Address {
  id         String   @id @default(cuid())
  street     String
  city       String
  state      String
  zipCode    String
  country    String
  postalCode String
  User       User[]
  school     School[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Owner {
  id                     String         @id @default(cuid())
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  preferredContactMethod String         @default("EMAIL")
  preferredContactTime   String         @default("MORNING")
  educationBackground    String?
  userId                 String
  isActive               Boolean        @default(false)
  professionalExperience String?
  currentPosition        String?
  previousPositions      String?
  yearsInEducation       Int?
  OwnersSchool           OwnersSchool[]
}

// bridge table for many-to-many relationship between User and School
model OwnersSchool {
  ownerId   String
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     Owner    @relation(fields: [ownerId], references: [id])
  school    School   @relation(fields: [schoolId], references: [id])

  @@id([ownerId, schoolId])
}

//Permissions model
model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  resource    String
  action      String
  description String?

  // Role-Permission bridge
  rolePermissions RolePermission[]
}

//Role model
model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isActive        Boolean          @default(true)
  // Creator of this role
  createdById     String
  createdBy       User             @relation("UserCreatedRoles", fields: [createdById], references: [id], onDelete: Cascade)
  // Relations
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

// ✅ RolePermission bridge (many-to-many between Role & Permission)
model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ✅ UserRole bridge (many-to-many between User & Role with metadata)
model UserRole {
  id           String   @id @default(uuid())
  userId       String
  roleId       String
  assignedById String
  assignedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User     @relation("AssignedByRelation", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Document {
  id       String     @id @default(cuid())
  url      String
  fileType FileType
  purpose  DocPurpose

  // Polymorphic-style linking
  schoolId String? // optional
  userId   String? // optional
  campusId String? // optional

  uploadedBy User?    @relation(fields: [userId], references: [id])
  school     School?  @relation(fields: [schoolId], references: [id])
  createdAt  DateTime @default(now())
}

enum FileType {
  IMAGE
  PDF
  DOCX
  XLSX
  PPTX
  TEXT
  CSV
  ZIP
  OTHER
}

enum DocPurpose {
  SCHOOL_LOGO
  SCHOOL_SEAL
  LICENSE_CERT
  PROOF_OF_ADDRESS
  HEADMASTER_ID
  GENERAL_UPLOAD
}

enum ContactMethod {
  EMAIL
  PHONE
  IN_PERSON
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED
  PENDING
  DELETED
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_VERIFICATION
  TWO_FACTOR_AUTHENTICATION
  CHANGE_EMAIL
  CHANGE_PHONE
  ACCOUNT_ACTIVATION
  ACCOUNT_DELETION
}
