generator client {
  provider = "prisma-client-js"
}

generator jsonSchema {
  provider                 = "prisma-json-schema-generator"
  output                   = "../src/prisma/schemas"
  keepRelationScalarFields = "false"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  firstName       String
  lastName        String
  password        String
  confirmPassword String
  isActive        Boolean         @default(false)
  status          AccountStatus   @default(ACTIVE)
  phone           String
  isPhoneVerified Boolean         @default(false)
  isEmailVerified Boolean         @default(false)
  lastLogedIn     DateTime        @default(now())
  schoolId        String?
  addressId       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  address         Address[]
  userRoles       UserRole[]
  assignedRoles   UserRole[]      @relation("AssignedByRelation")
  rolesCreated    Role[]          @relation("UserCreatedRoles")
  document        Document[]
  schoolProfile   SchoolProfile[]
  session         Session[]
  school          School?         @relation(fields: [schoolId], references: [id])
  updatedSchools  School[]        @relation("SchoolUpdatedByUser")
  schools         School[]        @relation("SchoolUser")
}

model School {
  id            String          @id @default(cuid())
  name          String
  isActive      Boolean         @default(false)
  status        AccountStatus   @default(ACTIVE)
  userId        String          @unique
  createdAt     DateTime        @default(now())
  updatedBy     User            @relation("SchoolUpdatedByUser", fields: [userId], references: [id], map: "School_userId_updatedBy_fkey")
  createdBy     User            @relation("SchoolUser", fields: [userId], references: [id], map: "School_userId_user_fkey")
  document      Document[]
  schoolProfile SchoolProfile[]
  owner         Owner[]
  plan          Plan[]
  user          User[]
}

model VerificationToken {
  id         String           @id @default(cuid())
  identifier String
  token      String           @unique
  expires    DateTime
  type       VerificationType
  createdAt  DateTime         @default(now())

  @@index([identifier])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String
  ipAddress    String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Relations
  user         User     @relation(fields: [userId], references: [id])

  @@index([sessionToken])
}

model SchoolProfile {
  id            String    @id @default(cuid())
  schoolId      String    @unique
  school        School    @relation(fields: [schoolId], references: [id])
  slogan        String
  about         String
  description   String
  contactEmail  String
  contactPhone  String
  establishedAt DateTime?
  motto         String
  colors        String? // e.g. "#ff0000,#ffffff"
  principalName String
  principalBio  String
  founderName   String
  founderBio    String?
  licenseNumber String?
  adminNote     String?
  updatedById   String
  updatedBy     User[]
  schoolAddress Address[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  price         Int // in cents (e.g. ₵29.99 -> 2999)
  billingCycle  BillingCycle
  isActive      Boolean        @default(true)
  features      PlanFeature[]
  limits        PlanLimits?
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  School        School?        @relation(fields: [schoolId], references: [id])
  schoolId      String?
}

model PlanFeature {
  id          String  @id @default(uuid())
  name        String
  description String
  isEnabled   Boolean
  metadata    Json?
  planId      String
  plan        Plan    @relation(fields: [planId], references: [id])
}

model PlanLimits {
  id               String @id @default(uuid())
  planId           String @unique
  plan             Plan   @relation(fields: [planId], references: [id])
  maxStudents      Int
  maxTeachers      Int
  maxClasses       Int
  maxDepartments   Int
  maxSubjects      Int
  maxQuizzes       Int
  maxNotifications Int
  maxFileUploadsMb Int
  maxTimetables    Int
}

model Subscription {
  id                 String             @id @default(uuid())
  schoolId           String
  planId             String
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  trialEnd           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  plan               Plan               @relation(fields: [planId], references: [id])
}

model Address {
  id            String         @id @default(cuid())
  street        String
  city          String
  region        String
  postalCode    String
  country       String
  modelId       String?
  schoolProfile SchoolProfile? @relation(fields: [modelId], references: [id], map: "Address_modelId_schoolProfile_fkey")
  user          User?          @relation(fields: [modelId], references: [id], map: "Address_modelId_user_fkey")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Owner {
  id                     String   @id @default(cuid())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  preferredContactMethod String   @default("EMAIL")
  preferredContactTime   String   @default("MORNING")
  educationBackground    String
  schoolId               String
  isActive               Boolean  @default(false)
  professionalExperience String
  currentPosition        String
  previousPositions      String
  yearsInEducation       Int
  school                 School   @relation(fields: [schoolId], references: [id])
}

// bridge table for many-to-many relationship between User and School
model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  resource        String
  action          String
  description     String?
  rolePermissions RolePermission[]
}

//Role model
model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isActive        Boolean          @default(true)
  createdById     String
  createdBy       User             @relation("UserCreatedRoles", fields: [createdById], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id           String   @id @default(uuid())
  userId       String
  roleId       String
  assignedById String
  assignedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User     @relation("AssignedByRelation", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Document {
  id         String     @id @default(cuid())
  url        String
  fileType   FileType
  isAcitve   Boolean    @default(true)
  purpose    DocPurpose
  schoolId   String?
  userId     String?
  campusId   String?
  uploadedBy User?      @relation(fields: [userId], references: [id])
  school     School?    @relation(fields: [schoolId], references: [id])
  createdAt  DateTime   @default(now())
}

enum FileType {
  IMAGE
  PDF
  DOCX
  XLSX
  PPTX
  TEXT
  CSV
  ZIP
  OTHER
}

enum DocPurpose {
  SCHOOL_LOGO
  SCHOOL_SEAL
  LICENSE_CERT
  PROOF_OF_ADDRESS
  HEADMASTER_ID
  GENERAL_UPLOAD
}

enum ContactMethod {
  EMAIL
  PHONE
  IN_PERSON
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED
  PENDING
  DELETED
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_VERIFICATION
  TWO_FACTOR_AUTHENTICATION
  CHANGE_EMAIL
  CHANGE_PHONE
  ACCOUNT_ACTIVATION
  ACCOUNT_DELETION
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  PAST_DUE
}
