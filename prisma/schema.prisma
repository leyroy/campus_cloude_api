generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  firstName       String
  lastName        String
  password        String
  confirmPassword String
  isActive        Boolean  @default(false)
  phone           String
  schoolId        String?
  addressId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  address Address? @relation(fields: [addressId], references: [id])
  school  School?  @relation(fields: [schoolId], references: [id])

  // Roles this user holds
  userRoles UserRole[]

  // Roles this user assigned to others
  assignedRoles UserRole[] @relation("AssignedByRelation")

  // Roles this user created
  rolesCreated Role[] @relation("UserCreatedRoles")
}

model School {
  id           String         @id @default(cuid())
  name         String
  description  String?
  userId       String
  ownerId      String
  isActive     Boolean        @default(false)
  addressId    String?
  address      Address?       @relation(fields: [addressId], references: [id])
  users        User[]
  owner        Owner          @relation(fields: [ownerId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  OwnersSchool OwnersSchool[]
}

model Address {
  id        String   @id @default(cuid())
  street    String
  city      String
  state     String
  zipCode   String
  schoolId  String?
  User      User[]
  school    School[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Owner {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  schools      School[]
  OwnersSchool OwnersSchool[]
}

// bridge table for many-to-many relationship between User and School
model OwnersSchool {
  ownerId   String
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     Owner    @relation(fields: [ownerId], references: [id])
  school    School   @relation(fields: [schoolId], references: [id])

  @@id([ownerId, schoolId])
}

//Permissions model
model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  resource    String
  action      String
  description String?

  // Role-Permission bridge
  rolePermissions RolePermission[]
}

//Role model
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  // Creator of this role
  createdById String
  createdBy   User   @relation("UserCreatedRoles", fields: [createdById], references: [id], onDelete: Cascade)

  // Relations
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

// ✅ RolePermission bridge (many-to-many between Role & Permission)
model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ✅ UserRole bridge (many-to-many between User & Role with metadata)
model UserRole {
  id           String   @id @default(uuid())
  userId       String
  roleId       String
  assignedById String
  assignedAt   DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User @relation("AssignedByRelation", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}
