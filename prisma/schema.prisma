generator client {
  provider = "prisma-client-js"
}

generator jsonSchema {
  provider                 = "prisma-json-schema-generator"
  output                   = "../src/prisma/schemas"
  keepRelationScalarFields = "false"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  firstName        String
  lastName         String
  password         String
  confirmPassword  String
  isActive         Boolean            @default(false)
  status           AccountStatus      @default(ACTIVE)
  phone            String
  isPhoneVerified  Boolean            @default(false)
  isEmailVerified  Boolean            @default(false)
  lastLogedIn      DateTime           @default(now())
  schoolId         String?
  addressId        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  address          Address[]
  userRoles        UserRole[]
  assignedRoles    UserRole[]         @relation("AssignedByRelation")
  rolesCreated     Role[]             @relation("UserCreatedRoles")
  session          Session[]
  school           School?            @relation(fields: [schoolId], references: [id])
  attendanceRecord AttendanceRecord[]
  teacher          Teacher[]
  grade            Grade[]
  assessment       Assessment[]
}

model School {
  id             String           @id @default(cuid())
  name           String
  isActive       Boolean          @default(false)
  level          Int              @default(0)
  educationLevel EducationLevel[]
  type           SchooleType      @default(PUBLIC)
  isDeleted      Boolean          @default(false)
  status         AccountStatus    @default(PENDING)
  updatedById    String
  createdAt      DateTime         @default(now())
  description    String
  schoolProfile  SchoolProfile[]
  subscription   Subscription[]
  ownerId        String
  department     Department[]
  subjects       Subject[]
  students       Student[]
  academicYears  AcademicYear[]
  courses        Course[]
  classes        Class[]

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  gradingSystem GradingSystem[]

  terms Term[]
  users User[]
}

model VerificationToken {
  id         String           @id @default(cuid())
  identifier String
  token      String           @unique
  expires    DateTime
  code       String?
  type       VerificationType
  createdAt  DateTime         @default(now())

  @@index([identifier])
}

model Department {
  id          String    @id @default(cuid())
  name        String
  description String?
  updatedById String
  schoolId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Relations
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courses     Course[]
  teachers    Teacher[]
  Student     Student[]

  @@unique([name, schoolId])
  @@index([schoolId])
}

model Subject {
  id           String         @id @default(cuid())
  name         String
  description  String?
  updatedById  String
  courseId     String?
  schoolId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  termId       String
  // Relations
  course       Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term         Term           @relation(fields: [termId], references: [id], onDelete: Cascade)
  classSubject ClassSubject[]
  grade        Grade[]
  assessments  Assessment[]

  @@index([schoolId])
  @@index([courseId])
  @@index([termId])
}

model AcademicYear {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(false)
  updatedById String
  schoolId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Relations
  school      School   @relation(fields: [schoolId], references: [id])
  term        Term[]
  classes     Class[]

  Assessment Assessment[]
}

model Term {
  id             String       @id @default(cuid())
  number         Int // 1, 2, 3
  name           String // "First Term", "Second Term", "Third Term"
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  academicYearId String
  school         School       @relation(fields: [schoolId], references: [id])
  schoolId       String

  // Relations
  assessments       Assessment[]
  reportCards       ReportCard[]
  attendanceRecords AttendanceRecord[]
  Subject           Subject[]

  @@unique([academicYearId, number])
  @@map("terms")
}

model Course {
  id           String     @id @default(cuid())
  name         String
  description  String?
  updatedById  String
  departmentId String
  schoolId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  // Relations
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  classes      Class[]
  subjects     Subject[]

  @@unique([name, departmentId])
  @@index([schoolId])
  @@index([departmentId])
}

// Assessment and Grading System
model GradingSystem {
  id        String         @id @default(cuid())
  name      String // e.g., "KG Descriptive", "Primary Percentage", "SHS WASSCE"
  type      GradingType
  level     EducationLevel
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  school      School       @relation(fields: [schoolId], references: [id])
  schoolId    String
  // Relations
  gradeScales GradeScale[]
  assessments Assessment[]

  @@map("grading_systems")
}

model GradeScale {
  id          String  @id @default(cuid())
  grade       String // "Excellent", "A1", "80-100%"
  minScore    Float
  maxScore    Float
  points      Float? // For GPA calculation
  description String?
  order       Int // For sorting grades

  gradingSystem   GradingSystem @relation(fields: [gradingSystemId], references: [id])
  gradingSystemId String

  @@map("grade_scales")
}

// TODO: learn more about this assessment table
model Assessment {
  id           String         @id @default(cuid())
  title        String
  type         AssessmentType
  weight       Float // Percentage weight in final grade
  totalMarks   Float
  instructions String?
  dueDate      DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  classSubject    ClassSubject  @relation(fields: [classSubjectId], references: [id])
  classSubjectId  String
  subject         Subject       @relation(fields: [subjectId], references: [id])
  subjectId       String
  term            Term          @relation(fields: [termId], references: [id])
  termId          String
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id])
  academicYearId  String
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdById     String
  teacher         Teacher       @relation(fields: [teacherId], references: [id])
  teacherId       String
  gradingSystem   GradingSystem @relation(fields: [gradingSystemId], references: [id])
  gradingSystemId String

  // Relations
  grades Grade[]

  @@map("assessments")
}

// Report Cards and Academic Records
model ReportCard {
  id                 String   @id @default(cuid())
  overallGrade       String?
  overallPercentage  Float?
  position           Int? // Class position
  totalStudents      Int? // Total students in class
  attendance         Json? // Attendance summary
  conduct            String? // Behavioral assessment
  teacherRemarks     String?
  headTeacherRemarks String?
  promoted           Boolean?
  nextClass          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  student   Student @relation(fields: [studentId], references: [id])
  studentId String
  term      Term    @relation(fields: [termId], references: [id])
  termId    String

  // Relations

  @@unique([studentId, termId])
  @@map("report_cards")
}

model Grade {
  id           String     @id @default(cuid())
  score        Float? // Raw score
  grade        String? // Computed grade (A1, Excellent, etc.)
  percentage   Float? // Percentage score
  points       Float? // Points for GPA
  remarks      String? // Teacher's comments
  gradedAt     DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  student      Student    @relation(fields: [studentId], references: [id])
  studentId    String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  assessmentId String
  subject      Subject    @relation(fields: [subjectId], references: [id])
  subjectId    String
  gradedBy     User       @relation(fields: [gradedById], references: [id])
  gradedById   String

  @@unique([studentId, assessmentId])
  @@map("grades")
}

model Teacher {
  id             String        @id @default(cuid())
  employeeNumber String        @unique
  qualification  String?
  specialization String?
  experience     Int? // Years of experience
  hireDate       DateTime
  status         TeacherStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id])
  userId         String        @unique
  department     Department?   @relation(fields: [departmentId], references: [id])
  departmentId   String?

  // Relations
  classSubjects      ClassSubject[]
  assessmentsCreated Assessment[]

  @@map("teachers")
}

// subject can belong to multiple class
//class can have meny subject
model ClassSubject {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class       Class        @relation(fields: [classId], references: [id])
  classId     String
  subject     Subject      @relation(fields: [subjectId], references: [id])
  subjectId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  teacherId   String
  // Relations
  assessments Assessment[]

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model Class {
  id               String             @id @default(cuid())
  name             String
  description      String?
  gradeLevel       Int
  updatedById      String
  courseId         String?
  schoolId         String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  // Relations
  school           School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course           Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student          Student[]
  academicYear     AcademicYear[]
  attendanceRecord AttendanceRecord[]
  classSubject     ClassSubject[]
}

model Student {
  id                      String                    @id @default(cuid())
  status                  AccountStatus             @default(PENDING)
  schoolId                String
  studentPhone            String?
  studentEmail            String?
  firstName               String
  lastName                String
  address                 String
  gender                  Gender
  religion                String?
  classId                 String?
  departmentId            String?
  dateOfBirth             DateTime
  createdAt               DateTime                  @default(now())
  indexNumber             String                    @unique
  updatedAt               DateTime                  @updatedAt
  // Relations
  department              Department?               @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  school                  School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class                   Class?                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  disciplinaryRecord      DisciplinaryRecord[]
  reportCard              ReportCard[]
  attendanceRecord        AttendanceRecord[]
  grade                   Grade[]
  studentGuardians        StudentGuardian[]
  studentAccadamicHistory StudentAccadamicHistory[]
}

model StudentAccadamicHistory {
  id           String   @id @default(cuid())
  studentId    String
  fromClass    String
  toClass      String
  academicYear String
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  date       DateTime         @db.Date
  status     AttendanceStatus
  remarks    String?
  recordedAt DateTime         @default(now())

  student      Student @relation(fields: [studentId], references: [id])
  studentId    String
  class        Class   @relation(fields: [classId], references: [id])
  classId      String
  term         Term    @relation(fields: [termId], references: [id])
  termId       String
  recordedBy   User    @relation(fields: [recordedById], references: [id])
  recordedById String

  @@unique([studentId, date])
  @@map("attendance_records")
}

// Discipline Management
model DisciplinaryRecord {
  id        String               @id @default(cuid())
  incident  String
  action    String? // Action taken
  date      DateTime             @db.Date
  severity  DisciplinarySeverity
  resolved  Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  @@map("disciplinary_records")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String
  ipAddress    String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Relations
  user         User     @relation(fields: [userId], references: [id])

  @@index([sessionToken])
}

model StudentGuardian {
  id            String           @id @default(cuid())
  firstName     String
  lastName      String
  relationship  RelationshipType
  guardianEmail String
  guardianPhone String
  address       String
  studentId     String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  // Relations
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model SchoolProfile {
  id            String    @id @default(cuid())
  schoolId      String    @unique
  updatedById   String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slogan        String
  about         String
  description   String
  contactEmail  String
  contactPhone  String
  establishedAt DateTime?
  motto         String
  colors        String?
  principalName String
  principalBio  String
  founderName   String
  founderBio    String
  licenseNumber String
  adminNote     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  schoolAddress Address[]
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  price         Int // in cents (e.g. ₵29.99 -> 2999)
  billingCycle  BillingCycle
  isActive      Boolean        @default(true)
  features      PlanFeature[]
  limits        PlanLimits?
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PlanFeature {
  id          String  @id @default(uuid())
  name        String
  description String
  isEnabled   Boolean
  metadata    Json?
  planId      String
  plan        Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model PlanLimits {
  id               String @id @default(uuid())
  planId           String @unique
  plan             Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  maxStudents      Int
  maxTeachers      Int
  maxClasses       Int
  maxDepartments   Int
  maxSubjects      Int
  maxQuizzes       Int
  maxNotifications Int
  maxFileUploadsMb Int
  maxTimetables    Int
}

model Subscription {
  id                 String             @id @default(uuid())
  schoolId           String
  planId             String
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  trialEnd           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  school             School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Address {
  id            String         @id @default(cuid())
  street        String
  city          String
  region        String
  postalCode    String
  country       String
  userId        String?
  schoolId      String?
  schoolProfile SchoolProfile? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Owner {
  id                     String   @id @default(cuid())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  preferredContactMethod String   @default("EMAIL")
  preferredContactTime   String   @default("MORNING")
  educationBackground    String
  isActive               Boolean  @default(false)
  professionalExperience String
  currentPosition        String
  previousPositions      String
  yearsInEducation       Int
  School                 School[]
}

// bridge table for many-to-many relationship between User and School
model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  resource        String
  action          String
  description     String?
  rolePermissions RolePermission[]
}

//Role model
model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isActive        Boolean          @default(true)
  createdById     String
  createdBy       User             @relation("UserCreatedRoles", fields: [createdById], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id           String   @id @default(uuid())
  userId       String
  roleId       String
  assignedById String
  assignedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User     @relation("AssignedByRelation", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Document {
  id          String     @id @default(cuid())
  url         String
  fileType    FileType
  isActive    Boolean    @default(true)
  documentKey String
  mudelId     String
  purpose     DocPurpose
  createdAt   DateTime   @default(now())
}

enum FileType {
  IMAGE
  PDF
  DOCX
  XLSX
  PPTX
  VIDEO
  TEXT
  CSV
  ZIP
  OTHER
}

enum RelationshipType {
  PARENT
  GUARDIAN
  SIBLING
  RELATIVE
  OTHER
}

enum DocPurpose {
  SCHOOL_LOGO
  SCHOOL_SEAL
  LICENSE_CERT
  PROOF_OF_ADDRESS
  HEADMASTER_ID
  GENERAL_UPLOAD
}

enum ContactMethod {
  EMAIL
  PHONE
  IN_PERSON
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED
  PENDING
  DELETED
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_VERIFICATION
  TWO_FACTOR_AUTHENTICATION
  CHANGE_EMAIL
  CHANGE_PHONE
  ACCOUNT_ACTIVATION
  ACCOUNT_DELETION
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  PAST_DUE
}

enum DisciplinarySeverity {
  MINOR
  MODERATE
  SERIOUS
  SEVERE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  SICK
}

enum AssessmentType {
  // KG Assessments
  OBSERVATION
  ACTIVITY_BASED
  PORTFOLIO
  // Primary Assessments
  CLASS_EXERCISE
  HOMEWORK
  PROJECT
  MID_TERM_EXAM
  END_OF_TERM_EXAM
  // JHS/SHS Assessments
  QUIZ
  ASSIGNMENT
  PRACTICAL
  CONTINUOUS_ASSESSMENT
  MOCK_EXAM
  EXTERNAL_EXAM // BECE, WASSCE
}

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  RETIRED
}

enum GradingType {
  DESCRIPTIVE // Excellent, Very Good, Good, Needs Support (KG)
  PERCENTAGE // 0-100% (Primary)
  LETTER_GRADE // A1-F9 (JHS/SHS)
  POINTS // GPA system
}

enum SchooleType {
  PUBLIC
  PRIVATE
  CHARTER
  MAGNET
  RELIGIOUS
  INTERNATIONAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EducationLevel {
  KG1
  PRIMARY
  JHS
}
